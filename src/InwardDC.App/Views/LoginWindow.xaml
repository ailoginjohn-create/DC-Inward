<Window x:Class="InwardDC.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign In - Inward &amp; DC"
        Width="420" Height="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1F4E78">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="40" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="1"
                   Text="Inward &amp; DC"
                   FontSize="30" FontWeight="Bold"
                   Foreground="White" HorizontalAlignment="Center"
                   Margin="0,60,0,10" />

        <StackPanel Grid.Row="1" Grid.Column="1">
            <TextBlock Text="User name" Foreground="#DCE6F2" />
            <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                     Padding="6" Margin="0,2,0,12" FontSize="14" />
            <TextBlock Text="Password" Foreground="#DCE6F2" />
            <PasswordBox x:Name="PasswordBox" Padding="6" Margin="0,2,0,12" FontSize="14"
                         PasswordChanged="PasswordBox_PasswordChanged" />
        </StackPanel>

        <Button Grid.Row="2" Grid.Column="1"
                Content="Sign In"
                Command="{Binding LoginCommand}"
                Background="#E8A33D" Foreground="#1A1A1A"
                FontSize="15" FontWeight="Bold" Padding="0,10"
                Margin="0,6,0,0" />

        <TextBlock Grid.Row="3" Grid.Column="1"
                   Text="{Binding ErrorMessage}" Foreground="#FFD0D0"
                   TextWrapping="Wrap" Margin="0,10,0,0" />

        <TextBlock Grid.Row="5" Grid.Column="1"
                   Text="{Binding StatusMessage}" Foreground="#BFE3BF"
                   HorizontalAlignment="Center" Margin="0,0,0,14" />
    </Grid>
</Window>
