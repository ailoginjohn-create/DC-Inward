<Window x:Class="InwardDC.App.Views.UserEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User"
        Width="520" Height="520"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" Padding="12,8"
                BorderBrush="#D5E0EC" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock Text="User" FontSize="20" FontWeight="Bold" Foreground="#1F4E78"
                           DockPanel.Dock="Left" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource ToolbarButton}" />
                    <Button Content="{Binding SaveText}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#EEF3F9" Padding="8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ErrorMessage}" VerticalAlignment="Center" Foreground="#B00020" Margin="12,0,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Margin="16">
            <TextBlock Text="User Name" />
            <TextBox Text="{Binding UserName}" IsReadOnly="{Binding IsNew, Converter={StaticResource InverseBoolConverter}}" />
            <TextBlock Text="Full Name" Margin="0,10,0,0" />
            <TextBox Text="{Binding FullName}" />
            <TextBlock Text="Email" Margin="0,10,0,0" />
            <TextBox Text="{Binding Email}" />
            <TextBlock Text="Phone" Margin="0,10,0,0" />
            <TextBox Text="{Binding Phone}" />
            <TextBlock Text="Role" Margin="0,10,0,0" />
            <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}" />
            <CheckBox Content="Active" IsChecked="{Binding IsActive}" Margin="0,14,0,0" />

            <TextBlock Text="Password" Margin="0,14,0,0" Visibility="{Binding IsNew, Converter={StaticResource BoolVisibilityConverter}}" />
            <PasswordBox x:Name="PasswordBox" Visibility="{Binding IsNew, Converter={StaticResource BoolVisibilityConverter}}" PasswordChanged="PasswordBox_PasswordChanged" />
            <TextBlock Text="Confirm Password" Margin="0,10,0,0" Visibility="{Binding IsNew, Converter={StaticResource BoolVisibilityConverter}}" />
            <PasswordBox x:Name="ConfirmPasswordBox" Visibility="{Binding IsNew, Converter={StaticResource BoolVisibilityConverter}}" PasswordChanged="PasswordBox_PasswordChanged" />
        </StackPanel>
    </DockPanel>
</Window>
