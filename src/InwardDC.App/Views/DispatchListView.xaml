<UserControl x:Class="InwardDC.App.Views.DispatchListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#D5E0EC" BorderThickness="1" Padding="10" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="+ New Challan" Style="{StaticResource PrimaryButton}" Command="{Binding NewCommand}" />
                <Button Content="PDF" Style="{StaticResource ToolbarButton}" Command="{Binding PdfCommand}" CommandParameter="{Binding SelectedItem}" />
                <Button Content="Cancel" Style="{StaticResource ToolbarButton}" Command="{Binding CancelCommand}" CommandParameter="{Binding SelectedItem}" />
                <Button Content="Delete" Style="{StaticResource ToolbarButton}" Command="{Binding DeleteCommand}" CommandParameter="{Binding SelectedItem}" />
                <Separator Width="1" Height="24" Background="#CCCCCC" Margin="8,0" />
                <Button Content="Template" Style="{StaticResource ToolbarButton}" Command="{Binding TemplateCommand}" />
                <Button Content="Import" Style="{StaticResource ToolbarButton}" Command="{Binding ImportCommand}" />
                <Button Content="Export" Style="{StaticResource ToolbarButton}" Command="{Binding ExportCommand}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#EEF3F9" Padding="8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Search:" VerticalAlignment="Center" />
                <TextBox Width="180" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="6,0" />
                <TextBlock Text="From:" VerticalAlignment="Center" />
                <DatePicker Width="120" SelectedDate="{Binding FromDate}" Margin="4,0" />
                <TextBlock Text="To:" VerticalAlignment="Center" />
                <DatePicker Width="120" SelectedDate="{Binding ToDate}" Margin="4,0" />
                <TextBlock Text="Status:" VerticalAlignment="Center" Margin="8,0,0,0" />
                <ComboBox Width="110" ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}" Margin="4,0" />
                <Button Content="Search" Command="{Binding SearchCommand}" Style="{StaticResource ToolbarButton}" />
                <TextBlock Text="{Binding TotalCount, StringFormat={}{0} record(s)}" VerticalAlignment="Center" Margin="16,0,0,0" />
                <Button Content="Prev" Command="{Binding PrevPageCommand}" IsEnabled="{Binding CanGoBack}" Style="{StaticResource ToolbarButton}" />
                <TextBlock Text="Page" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Page, StringFormat={}{0}}" VerticalAlignment="Center" />
                <Button Content="Next" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}" Style="{StaticResource ToolbarButton}" />
            </StackPanel>
        </Border>

        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  HeadersVisibility="Column" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="DC No" Binding="{Binding DcNo}" Width="130" />
                <DataGridTextColumn Header="Date" Binding="{Binding DcDate, StringFormat=d}" Width="90" />
                <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*" />
                <DataGridTextColumn Header="Invoice No" Binding="{Binding InvoiceNo}" Width="100" />
                <DataGridTextColumn Header="Payment" Binding="{Binding PaymentStatus}" Width="90" />
                <DataGridTextColumn Header="Mode" Binding="{Binding ModeOfDispatch}" Width="90" />
                <DataGridTextColumn Header="Qty" Binding="{Binding TotalQuantity}" Width="60" />
                <DataGridTextColumn Header="Amount" Binding="{Binding TotalAmount, StringFormat={}{0:₹#,##0.00}}" Width="100" />
                <DataGridTextColumn Header="Status" Binding="{Binding StatusName}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
