<Window x:Class="InwardDC.App.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inward &amp; DC"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left navigation rail -->
        <Border Grid.Column="0" Background="#0F2C4C">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="12,8">
                    <TextBlock Text="{Binding UserDisplay}" Foreground="#DCE6F2"
                               FontSize="13" TextWrapping="Wrap" HorizontalAlignment="Center" />
                    <Button Content="Sign Out" Command="{Binding SignOutCommand}"
                            HorizontalAlignment="Center" Margin="0,10,0,0"
                            Background="#1F4E78" Foreground="White" Padding="14,6" />
                </StackPanel>
                <StackPanel Margin="0,16,0,0">
                    <TextBlock Text="Inward &amp; DC" Foreground="White" FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,18" />
                    <ListBox ItemsSource="{Binding NavItems}"
                             SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" Padding="16,10" FontSize="14"
                                           Foreground="#DCE6F2" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="#DCE6F2" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#1F4E78" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#163A5C" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main content -->
        <Grid Grid.Column="1" Background="#F4F7FB">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="White" Padding="14,10"
                    BorderBrush="#D5E0EC" BorderThickness="0,0,0,1">
                <TextBlock Text="{Binding CurrentTitle}" FontSize="22" FontWeight="Bold" Foreground="#1F4E78" />
            </Border>
            <ContentControl Grid.Row="1" Content="{Binding CurrentContent}" />
        </Grid>
    </Grid>
</Window>
