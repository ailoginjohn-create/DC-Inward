<Window x:Class="InwardDC.App.Views.ItemEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Item"
        Width="620" Height="580"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" Padding="12,8"
                BorderBrush="#D5E0EC" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock Text="Item" FontSize="20" FontWeight="Bold" Foreground="#1F4E78"
                           DockPanel.Dock="Left" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource ToolbarButton}" />
                    <Button Content="{Binding SaveText}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#EEF3F9" Padding="8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ErrorMessage}" VerticalAlignment="Center" Foreground="#B00020" Margin="12,0,0,0" />
            </StackPanel>
        </Border>

        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="Code" />
                <TextBox Text="{Binding Code}" />
                <TextBlock Text="Name *" Margin="0,8,0,0" />
                <TextBox Text="{Binding Name}" />
                <TextBlock Text="Category" Margin="0,8,0,0" />
                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}"
                          DisplayMemberPath="DisplayName" />
                <TextBlock Text="Unit" Margin="0,8,0,0" />
                <TextBox Text="{Binding Unit}" />
                <CheckBox Content="Serial tracked" IsChecked="{Binding IsSerialTracked}" Margin="0,12,0,0" />
                <CheckBox Content="Active" IsChecked="{Binding IsActive}" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock Text="Make" />
                <TextBox Text="{Binding Make}" />
                <TextBlock Text="Model" Margin="0,8,0,0" />
                <TextBox Text="{Binding Model}" />
                <TextBlock Text="HSN Code" Margin="0,8,0,0" />
                <TextBox Text="{Binding HsnCode}" />
                <TextBlock Text="Description" Margin="0,8,0,0" />
                <TextBox Text="{Binding Description}" AcceptsReturn="True" Height="120" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
