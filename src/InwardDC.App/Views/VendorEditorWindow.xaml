<Window x:Class="InwardDC.App.Views.VendorEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vendor"
        Width="760" Height="640"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" Padding="12,8"
                BorderBrush="#D5E0EC" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock Text="Vendor" FontSize="20" FontWeight="Bold" Foreground="#1F4E78"
                           DockPanel.Dock="Left" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource ToolbarButton}" />
                    <Button Content="{Binding SaveText}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#EEF3F9" Padding="8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ErrorMessage}" VerticalAlignment="Center" Foreground="#B00020" Margin="12,0,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Code" />
                    <TextBox Text="{Binding Code}" />
                    <TextBlock Text="Name *" Margin="0,8,0,0" />
                    <TextBox Text="{Binding Name}" />
                    <TextBlock Text="Contact Person" Margin="0,8,0,0" />
                    <TextBox Text="{Binding ContactPerson}" />
                    <TextBlock Text="Phone" Margin="0,8,0,0" />
                    <TextBox Text="{Binding Phone}" />
                    <TextBlock Text="Mobile" Margin="0,8,0,0" />
                    <TextBox Text="{Binding Mobile}" />
                    <TextBlock Text="Email" Margin="0,8,0,0" />
                    <TextBox Text="{Binding Email}" />
                    <CheckBox Content="Active" IsChecked="{Binding IsActive}" Margin="0,12,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="Address Line 1" />
                    <TextBox Text="{Binding AddressLine1}" />
                    <TextBlock Text="Address Line 2" Margin="0,8,0,0" />
                    <TextBox Text="{Binding AddressLine2}" />
                    <TextBlock Text="City" Margin="0,8,0,0" />
                    <TextBox Text="{Binding City}" />
                    <TextBlock Text="State" Margin="0,8,0,0" />
                    <TextBox Text="{Binding State}" />
                    <TextBlock Text="Pincode" Margin="0,8,0,0" />
                    <TextBox Text="{Binding Pincode}" />
                    <TextBlock Text="Country" Margin="0,8,0,0" />
                    <TextBox Text="{Binding Country}" />
                    <TextBlock Text="GSTIN" Margin="0,8,0,0" />
                    <TextBox Text="{Binding Gstin}" />
                    <TextBlock Text="PAN" Margin="0,8,0,0" />
                    <TextBox Text="{Binding Pan}" />
                    <TextBlock Text="Notes" Margin="0,8,0,0" />
                    <TextBox Text="{Binding Notes}" AcceptsReturn="True" Height="70" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
