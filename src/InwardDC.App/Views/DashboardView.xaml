<UserControl x:Class="InwardDC.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <TextBlock Text="{Binding Greeting}" FontSize="16" Foreground="#333333" Margin="0,0,0,14" />

            <UniformGrid Columns="4" Margin="0,0,0,14">
                <Border Style="{StaticResource StatCard}">
                    <StackPanel><TextBlock Text="Inward Entries" Foreground="#888888" /><TextBlock Text="{Binding Stats.TotalInwardEntries}" Style="{StaticResource StatValue}" /></StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel><TextBlock Text="This Month (INW)" Foreground="#888888" /><TextBlock Text="{Binding Stats.InwardThisMonth}" Style="{StaticResource StatValue}" /><TextBlock Text="{Binding Stats.InwardAmountThisMonth, StringFormat={}{0:₹#,##0.00}}" Foreground="#1F4E78" /></StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel><TextBlock Text="Dispatch Challans" Foreground="#888888" /><TextBlock Text="{Binding Stats.TotalDcs}" Style="{StaticResource StatValue}" /><TextBlock Text="{Binding Stats.DcAmountThisMonth, StringFormat={}{0:₹#,##0.00}}" Foreground="#1F4E78" /></StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel><TextBlock Text="Items In Stock" Foreground="#888888" /><TextBlock Text="{Binding Stats.ItemsInStock}" Style="{StaticResource StatValue}" /></StackPanel>
                </Border>
            </UniformGrid>

            <UniformGrid Columns="2" Margin="0,0,0,14">
                <Border Style="{StaticResource StatCard}">
                    <StackPanel><TextBlock Text="Customers" Foreground="#888888" /><TextBlock Text="{Binding Stats.TotalCustomers}" Style="{StaticResource StatValue}" /></StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel><TextBlock Text="Pending Dispatch Lines" Foreground="#888888" /><TextBlock Text="{Binding Stats.PendingDispatch}" Style="{StaticResource StatValue}" /></StackPanel>
                </Border>
            </UniformGrid>

            <UniformGrid Columns="2">
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="Recent Inwards" FontWeight="Bold" FontSize="14" Foreground="#1F4E78" Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding Stats.RecentInwards}" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" Height="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="No" Binding="{Binding Number}" Width="110" />
                                <DataGridTextColumn Header="Party" Binding="{Binding Party}" Width="*" />
                                <DataGridTextColumn Header="Amount" Binding="{Binding TotalAmount, StringFormat={}{0:₹#,##0.00}}" Width="90" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="70" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="Recent Dispatch Challans" FontWeight="Bold" FontSize="14" Foreground="#1F4E78" Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding Stats.RecentDcs}" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" Height="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="No" Binding="{Binding Number}" Width="110" />
                                <DataGridTextColumn Header="Party" Binding="{Binding Party}" Width="*" />
                                <DataGridTextColumn Header="Amount" Binding="{Binding TotalAmount, StringFormat={}{0:₹#,##0.00}}" Width="90" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="70" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
