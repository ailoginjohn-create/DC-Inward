<Window x:Class="InwardDC.App.Views.FolderPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Folder"
        Width="560" Height="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12">
            <Button Content="OK" Width="90" IsDefault="True" Click="OnOk" Style="{StaticResource PrimaryButton}" />
            <Button Content="Cancel" Width="90" IsCancel="True" Margin="8,0,0,0" Style="{StaticResource ToolbarButton}" />
        </StackPanel>

        <Border Margin="12" Background="White" BorderBrush="#D5E0EC" BorderThickness="1" Padding="6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Choose a folder:" Margin="2,2,2,6" />
                <TreeView x:Name="FolderTree" ItemsSource="{Binding RootNodes}"
                          SelectedItemChanged="OnSelectionChanged" BorderThickness="0">
                    <TreeView.Resources>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="False" />
                            <EventSetter Event="Expanded" Handler="OnExpanded" />
                        </Style>
                    </TreeView.Resources>
                </TreeView>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
