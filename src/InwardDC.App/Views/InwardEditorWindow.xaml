<Window x:Class="InwardDC.App.Views.InwardEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inward Entry"
        Width="1050" Height="680"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" Padding="12,8"
                BorderBrush="#D5E0EC" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Foreground="#1F4E78"
                           DockPanel.Dock="Left" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource ToolbarButton}" />
                    <Button Content="{Binding StatusMessage}" Style="{StaticResource ToolbarButton}" Visibility="Collapsed" />
                    <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#EEF3F9" Padding="8" Height="Auto">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="#333333" />
                <TextBlock Text="{Binding ErrorMessage}" VerticalAlignment="Center" Foreground="#B00020" Margin="12,0,0,0" />
            </StackPanel>
        </Border>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header fields -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Inward No" />
                    <TextBox Text="{Binding InwardNo, Mode=OneWay}" IsReadOnly="True" Background="#EEF0F4" />
                    <TextBlock Text="Type" Margin="0,6,0,0" />
                    <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding InwardType}" />
                    <TextBlock Text="Customer" Margin="0,6,0,0" />
                    <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding Customer}"
                              DisplayMemberPath="Name" />
                    <TextBlock Text="Ref Invoice No" Margin="0,6,0,0" />
                    <TextBox Text="{Binding ReferenceInvoiceNo}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="Inward Date" />
                    <DatePicker SelectedDate="{Binding InwardDate}" />
                    <TextBlock Text="Status" Margin="0,6,0,0" />
                    <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}" />
                    <TextBlock Text="Vendor" Margin="0,6,0,0" />
                    <ComboBox ItemsSource="{Binding Vendors}" SelectedItem="{Binding Vendor}"
                              DisplayMemberPath="Name" />
                    <TextBlock Text="Purpose" Margin="0,6,0,0" />
                    <ComboBox ItemsSource="{Binding Purposes}" SelectedItem="{Binding Purpose}"
                              DisplayMemberPath="Name" />
                    <TextBlock Text="Ref Invoice Date" Margin="0,6,0,0" />
                    <DatePicker SelectedDate="{Binding ReferenceInvoiceDate}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Text="Challan No" />
                    <TextBox Text="{Binding ChallanNo}" />
                    <TextBlock Text="Transport Details" Margin="0,6,0,0" />
                    <TextBox Text="{Binding TransportDetails}" AcceptsReturn="True" Height="60" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="Remarks" />
                    <TextBox Text="{Binding Remarks}" AcceptsReturn="True" Height="88" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!-- Lines -->
            <DockPanel Grid.Row="1" Margin="0,12,0,0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Items" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                    <Button Content="+ Add Line" Command="{Binding AddLineCommand}" Style="{StaticResource ToolbarButton}" Margin="12,0,0,0" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding Lines}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          RowHeight="30">
                    <DataGrid.Columns>
                        <DataGridComboBoxColumn Header="Master Item" Width="200"
                                                ItemsSource="{Binding DataContext.MasterItems, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                SelectedValueBinding="{Binding ItemId, UpdateSourceTrigger=PropertyChanged}"
                                                SelectedValuePath="Id"
                                                DisplayMemberPath="DisplayName" />
                        <DataGridTextColumn Header="Item Name" Width="*" Binding="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridTextColumn Header="Make" Width="90" Binding="{Binding ItemMake, UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridTextColumn Header="Model" Width="90" Binding="{Binding ItemModel, UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridTextColumn Header="HSN" Width="90" Binding="{Binding HsnCode, UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridTextColumn Header="Unit" Width="60" Binding="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridTextColumn Header="Qty" Width="60" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridTextColumn Header="Rate" Width="80" Binding="{Binding Rate, UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridTextColumn Header="Amount" Width="90" Binding="{Binding Amount, Mode=OneWay}" IsReadOnly="True" />
                        <DataGridTextColumn Header="Serials (one per line)" Width="160" Binding="{Binding SerialsText, UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridTemplateColumn Header="" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Remove" Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
