<Window x:Class="InwardDC.App.Views.ItemCategoryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Item Category"
        Width="520" Height="400"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" Padding="12,8"
                BorderBrush="#D5E0EC" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock Text="Item Category" FontSize="20" FontWeight="Bold" Foreground="#1F4E78"
                           DockPanel.Dock="Left" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource ToolbarButton}" />
                    <Button Content="{Binding SaveText}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#EEF3F9" Padding="8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ErrorMessage}" VerticalAlignment="Center" Foreground="#B00020" Margin="12,0,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Margin="16">
            <TextBlock Text="Code" />
            <TextBox Text="{Binding Code}" />
            <TextBlock Text="Name *" Margin="0,10,0,0" />
            <TextBox Text="{Binding Name}" />
            <TextBlock Text="Description" Margin="0,10,0,0" />
            <TextBox Text="{Binding Description}" AcceptsReturn="True" Height="80" TextWrapping="Wrap" />
            <CheckBox Content="Active" IsChecked="{Binding IsActive}" Margin="0,14,0,0" />
        </StackPanel>
    </DockPanel>
</Window>
