<UserControl x:Class="InwardDC.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#D5E0EC" BorderThickness="1" Padding="10" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Report:" VerticalAlignment="Center" />
                <ComboBox Width="170" ItemsSource="{Binding ReportKinds}" SelectedItem="{Binding ReportKind}" Margin="6,0" />
                <TextBlock Text="From:" VerticalAlignment="Center" />
                <DatePicker Width="120" SelectedDate="{Binding FromDate}" Margin="4,0" />
                <TextBlock Text="To:" VerticalAlignment="Center" />
                <DatePicker Width="120" SelectedDate="{Binding ToDate}" Margin="4,0" />
                <Button Content="Generate" Command="{Binding GenerateCommand}" Style="{StaticResource PrimaryButton}" />
                <Separator Width="1" Height="24" Background="#CCCCCC" Margin="8,0" />
                <Button Content="Export Excel" Command="{Binding ExportExcelCommand}" Style="{StaticResource ToolbarButton}" />
                <Button Content="Export PDF" Command="{Binding ExportPdfCommand}" Style="{StaticResource ToolbarButton}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#EEF3F9" Padding="8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ErrorMessage}" VerticalAlignment="Center" Foreground="#B00020" Margin="12,0,0,0" />
            </StackPanel>
        </Border>

        <Grid>
            <DataGrid ItemsSource="{Binding DailyRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
                <DataGrid.Style>
                    <Style TargetType="DataGrid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ReportKind}" Value="Daily">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Style>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=d}" Width="120" />
                    <DataGridTextColumn Header="Inward Count" Binding="{Binding InwardCount}" Width="100" />
                    <DataGridTextColumn Header="Inward Amount" Binding="{Binding InwardAmount, StringFormat={}{0:₹#,##0.00}}" Width="120" />
                    <DataGridTextColumn Header="DC Count" Binding="{Binding DcCount}" Width="100" />
                    <DataGridTextColumn Header="DC Amount" Binding="{Binding DcAmount, StringFormat={}{0:₹#,##0.00}}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid ItemsSource="{Binding MonthlyRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
                <DataGrid.Style>
                    <Style TargetType="DataGrid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ReportKind}" Value="Monthly">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Style>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Month" Binding="{Binding YearMonth}" Width="120" />
                    <DataGridTextColumn Header="Inward Count" Binding="{Binding InwardCount}" Width="100" />
                    <DataGridTextColumn Header="Inward Amount" Binding="{Binding InwardAmount, StringFormat={}{0:₹#,##0.00}}" Width="120" />
                    <DataGridTextColumn Header="DC Count" Binding="{Binding DcCount}" Width="100" />
                    <DataGridTextColumn Header="DC Amount" Binding="{Binding DcAmount, StringFormat={}{0:₹#,##0.00}}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid ItemsSource="{Binding CustomerRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
                <DataGrid.Style>
                    <Style TargetType="DataGrid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ReportKind}" Value="CustomerWise">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Style>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Party" Binding="{Binding PartyName}" Width="*" />
                    <DataGridTextColumn Header="INW Units" Binding="{Binding InwardUnits}" Width="80" />
                    <DataGridTextColumn Header="INW Amount" Binding="{Binding InwardAmount, StringFormat={}{0:₹#,##0.00}}" Width="110" />
                    <DataGridTextColumn Header="DC Units" Binding="{Binding DcUnits}" Width="80" />
                    <DataGridTextColumn Header="DC Amount" Binding="{Binding DcAmount, StringFormat={}{0:₹#,##0.00}}" Width="110" />
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid ItemsSource="{Binding ItemRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
                <DataGrid.Style>
                    <Style TargetType="DataGrid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ReportKind}" Value="ItemWise">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Style>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Item" Binding="{Binding ItemName}" Width="*" />
                    <DataGridTextColumn Header="Make" Binding="{Binding Make}" Width="100" />
                    <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="100" />
                    <DataGridTextColumn Header="INW Units" Binding="{Binding InwardUnits}" Width="80" />
                    <DataGridTextColumn Header="INW Amount" Binding="{Binding InwardAmount, StringFormat={}{0:₹#,##0.00}}" Width="110" />
                    <DataGridTextColumn Header="Dispatched" Binding="{Binding DispatchedUnits}" Width="80" />
                    <DataGridTextColumn Header="In Stock" Binding="{Binding InStock}" Width="80" />
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid ItemsSource="{Binding DetailRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
                <DataGrid.Style>
                    <Style TargetType="DataGrid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ReportKind}" Value="InwardDetail">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ReportKind}" Value="DispatchDetail">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Style>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=d}" Width="90" />
                    <DataGridTextColumn Header="Number" Binding="{Binding Number}" Width="130" />
                    <DataGridTextColumn Header="Party" Binding="{Binding Party}" Width="*" />
                    <DataGridTextColumn Header="Item" Binding="{Binding ItemName}" Width="*" />
                    <DataGridTextColumn Header="Serial" Binding="{Binding SerialNo}" Width="100" />
                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="60" />
                    <DataGridTextColumn Header="Rate" Binding="{Binding Rate, StringFormat={}{0:₹#,##0.00}}" Width="80" />
                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat={}{0:₹#,##0.00}}" Width="90" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>
