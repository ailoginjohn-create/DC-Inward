<Application x:Class="InwardDC.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:InwardDC.App.ViewModels"
             xmlns:views="clr-namespace:InwardDC.App.Views"
             xmlns:conv="clr-namespace:InwardDC.App.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
        <conv:BoolVisibilityConverter x:Key="BoolVisibilityConverter" />

        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:InwardListViewModel}"><views:InwardListView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DispatchListViewModel}"><views:DispatchListView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomersViewModel}"><views:CustomersView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:VendorsViewModel}"><views:VendorsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ItemsViewModel}"><views:ItemsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ItemCategoriesViewModel}"><views:ItemCategoriesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PurposesViewModel}"><views:PurposesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsersViewModel}"><views:UsersView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SearchViewModel}"><views:SearchView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}"><views:ReportsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BackupViewModel}"><views:BackupView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuditViewModel}"><views:AuditView /></DataTemplate>

        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#DCE6F2" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,2,0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4">
                            <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}">
                                <TextBlock x:Name="Icon" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="16" Foreground="#A9C7E8" Margin="0,0,12,0" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1F4E78" />
                                <Setter TargetName="Icon" Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#163A5C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1F4E78" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="4,0" />
        </Style>

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="4,0" />
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D5E0EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="4" />
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#1F4E78" />
        </Style>
    </Application.Resources>
</Application>
